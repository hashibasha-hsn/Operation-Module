# Frontend env (Vite). Copy to client/.env.local or project root .env before build.
#
# Local (default if unset):
# VITE_API_GATEWAY_URL=http://localhost:3009
#
# Azure / cloud:
# VITE_API_GATEWAY_URL=https://your-api-gateway.azurewebsites.net
#
# Build-time only: Vite embeds this value into the client bundle.
# Use different values for Azure slots / branches (dev vs production).

VITE_API_GATEWAY_URL=http://localhost:3009
