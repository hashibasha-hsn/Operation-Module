{
  "name": "hashibasha",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "start:user": "npm run start:dev --prefix server/user-service",
    "start:org": "npm run start:dev --prefix server/org-service",
    "start:audit-log": "npm run start:dev --prefix server/audit-log-service",
    "start:gateway": "npm run start:dev --prefix server/api-gateway",
    "setup:db": "node server/database/setup-all.cjs",
    "setup:db:sample": "node server/database/setup-all.cjs --with-sample-data",
    "migrate:supabase": "node server/database/migrate-to-supabase.cjs",
    "reset:auth-user": "node server/database/reset-auth-user-data.cjs",
    "seed:admin": "node server/database/seed-admin-user.js",
    "setup:location-db": "node server/database/setup-sa-location-db.cjs",
    "import:location-data": "node server/database/import-sa-location-from-excel.cjs",
    "setup:location-country-db": "node server/database/setup-location-country-state-city.cjs",
    "import:location-country-data": "node server/database/import-location-country-data.cjs",
    "migrate:entity-location": "node server/database/migrate-entity-location-columns.cjs",
    "import:all-location-data": "node server/database/import-sa-location-from-excel.cjs && node server/database/import-location-country-data.cjs",
    "setup:language-db": "node server/database/setup-language-db.cjs",
    "import:language-data": "node server/database/import-language-data.cjs",
    "sync:translations": "node server/database/sync-all-translations.cjs",
    "setup:reporting-modules": "node server/database/setup-reporting-modules.cjs",
    "setup:tickets": "node server/database/setup-tickets.cjs",
    "test:tickets": "node server/database/test-tickets-flow.cjs",
    "setup:audit-logs": "node server/database/setup-audit-logs.cjs",
    "test:audit-logs": "node server/database/test-audit-logs-flow.cjs",
    "reset:admin-password": "node server/update-password.js",
    "test:entity-crud": "node server/database/test-entity-crud.js",
    "start:all": "concurrently -n user,org,audit,gateway,web -c blue,magenta,yellow,red,violet \"npm run start:user\" \"npm run start:org\" \"npm run start:audit-log\" \"npm run start:gateway\" \"npm run dev\""
  },
  "dependencies": {
