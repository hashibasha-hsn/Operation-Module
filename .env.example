# Copy this file to .env and fill in your local values.
# PowerShell: Copy-Item .env.example .env

# Supabase API (optional — for reference / future integrations)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# PostgreSQL (required for database setup and all backend services)
# Local:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password

# Supabase:
# DB_HOST=db.<project-ref>.supabase.co
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_supabase_database_password
# DB_NAME=postgres
# DB_SSL=true
# DB_SCHEMA=auth|user|org|notification|permission|location|language  (one per service)

# Optional: override default database names
# AUTH_DB_NAME=hashibasha_auth
# USER_DB_NAME=hashibasha_user
# ORG_DB_NAME=hashibasha_org
# NOTIFICATION_DB_NAME=hashibasha_notification
# PERMISSION_DB_NAME=hashibasha_permission
# LOCATION_DB_NAME=hashibasha_location
# LANGUAGE_DB_NAME=hashibasha_language

# JWT secret (change in production)
JWT_SECRET=change-me-local-dev-secret

# Admin user (used by npm run seed:admin)
ADMIN_EMAIL=admin@hashibasha.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=System Admin
ADMIN_EMPLOYEE_ID=ADMIN001
ADMIN_DESIGNATION=Company Admin

# Service ports — four-backend mode (npm run start:all)
# GATEWAY_PORT=3009
# USER_SERVICE_URL=http://localhost:3002
# ORG_SERVICE_URL=http://localhost:3012
# AUDIT_LOG_SERVICE_URL=http://localhost:3015
# Auth / permission / notification are hosted by user-service:
# AUTH_SERVICE_URL=http://localhost:3002
# NOTIFICATION_SERVICE_URL=http://localhost:3002
# PERMISSION_SERVICE_URL=http://localhost:3002
# Location / language are hosted by org-service:
# LOCATION_SERVICE_URL=http://localhost:3012
# LANGUAGE_SERVICE_URL=http://localhost:3012

# Multi-schema when services share one DATABASE_URL (Supabase)
# USER_DB_SCHEMA=hashibasha_user
# AUTH_DB_SCHEMA=hashibasha_auth
# PERMISSION_DB_SCHEMA=hashibasha_permission
# NOTIFICATION_DB_SCHEMA=hashibasha_notification
# ORG_DB_SCHEMA=hashibasha_org
# LOCATION_DB_SCHEMA=hashibasha_location
# LANGUAGE_DB_SCHEMA=hashibasha_language

# SMTP (notification hosted in user-service — required for welcome / system emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Hashibasha <noreply@yourdomain.com>
# FRONTEND_URL=http://localhost:3000
