# Copy this file to .env and fill in your local values.
# PowerShell: Copy-Item .env.example .env

# PostgreSQL / Supabase (DATABASE_URL preferred for cloud)
# Local:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password

# Supabase (Session pooler recommended):
# DATABASE_URL=postgresql://postgres.<project-ref>:<URL_ENCODED_PASSWORD>@aws-1-<region>.pooler.supabase.com:5432/postgres
# DB_SSL=true
# DB_SCHEMA=hashibasha_auth|hashibasha_user|hashibasha_org|...  (one per service)

# JWT secret (change in production)
JWT_SECRET=change-me-local-dev-secret

# Admin user (used by npm run seed:admin)
ADMIN_EMAIL=admin@hashibasha.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=System Admin
ADMIN_EMPLOYEE_ID=ADMIN001
ADMIN_DESIGNATION=Company Admin

# --- Inter-service URLs (required in Azure / Railway) ---
# Local defaults work without setting these.
# PORT is used by Azure App Service. GATEWAY_PORT is an optional local override for the gateway.
# PORT=3009
# GATEWAY_PORT=3009
# AUTH_SERVICE_URL=http://localhost:3003
# USER_SERVICE_URL=http://localhost:3002
# ORG_SERVICE_URL=http://localhost:3012
# LOCATION_SERVICE_URL=http://localhost:3013
# LANGUAGE_SERVICE_URL=http://localhost:3014
# NOTIFICATION_SERVICE_URL=http://localhost:3004
# PERMISSION_SERVICE_URL=http://localhost:3005
