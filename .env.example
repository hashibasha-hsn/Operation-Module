# Copy this file to .env and fill in your local values.
# PowerShell: Copy-Item .env.example .env

# PostgreSQL (required for database setup and all backend services)
# Local:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password

# Supabase:
# DB_HOST=db.<project-ref>.supabase.co
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_supabase_database_password
# DB_NAME=postgres
# DB_SSL=true
# DB_SCHEMA=auth|user|org|notification|permission|location|language  (one per service)

# Optional: override default database names
# AUTH_DB_NAME=hashibasha_auth
# USER_DB_NAME=hashibasha_user
# ORG_DB_NAME=hashibasha_org
# NOTIFICATION_DB_NAME=hashibasha_notification
# PERMISSION_DB_NAME=hashibasha_permission
# LOCATION_DB_NAME=hashibasha_location
# LANGUAGE_DB_NAME=hashibasha_language

# JWT secret (change in production)
JWT_SECRET=change-me-local-dev-secret

# Admin user (used by npm run seed:admin)
ADMIN_EMAIL=admin@hashibasha.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=System Admin
ADMIN_EMPLOYEE_ID=ADMIN001
ADMIN_DESIGNATION=Company Admin

# Service ports (defaults shown — usually no need to change)
# GATEWAY_PORT=3009
# AUTH_SERVICE_URL=http://localhost:3003
# USER_SERVICE_URL=http://localhost:3002
# ORG_SERVICE_URL=http://localhost:3012
# LOCATION_SERVICE_URL=http://localhost:3013
# LANGUAGE_SERVICE_URL=http://localhost:3014
# NOTIFICATION_SERVICE_URL=http://localhost:3004
# PERMISSION_SERVICE_URL=http://localhost:3005
